# Copy to .env (never commit .env).  cp .env.example .env
# --- OpenAI (provider: openai) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# --- Ollama (provider: ollama) — local server, no key needed
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
# --- HuggingFace token: needed only for gated models (Llama-3 QLoRA)
HF_TOKEN=hf_...
# --- Optional overrides
# IPI_LLM_PROVIDER=ollama
# IPI_CONFIG=configs/config.yaml
# IPI_LOG_LEVEL=INFO
