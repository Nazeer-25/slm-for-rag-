# Optional settings. Copy this file to .env and uncomment what you need.
# Environment variables set in the terminal take precedence over this file.

# Local generation (default)
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional remote provider (may incur API charges)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Retrieval and website
# TOP_K=3
# WORKBENCH_PORT=8000

# Load Hugging Face models from the local cache only (after the first run)
# HF_HUB_OFFLINE=1
